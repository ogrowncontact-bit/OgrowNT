# Postgres connection used by packages/db (Prisma).
# Local dev default matches the dev role/database created for this repo.
DATABASE_URL="postgresql://inner_dev:inner_dev@localhost:5432/inner_dev?schema=public"

# Anonymous session cookie signing secret (Phase 1). Generate a long random value per environment.
SESSION_SECRET="dev-only-change-me"

# AES-256 key for encrypting open-text assessment answers at rest (Phase 1, §12).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="dev-only-change-me"

# Question AI, Response AI, Profile AI (Phase 2, packages/ai). Every AI call
# degrades gracefully without this — set it to see live model output instead
# of the deterministic fallback heuristics.
# ANTHROPIC_API_KEY=

# PDF report rendering (Phase 3, packages/pdf) needs a Chromium install.
# Normally `playwright install chromium` in your build step is enough and
# this can stay unset; only set it if you have a pre-installed browser at a
# fixed, non-default path.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Absolute origin used to build checkout/report links (webhooks, emails). Falls
# back to the incoming request's own origin when unset, which is fine for
# local dev but should be set explicitly in any real deployment.
# APP_BASE_URL="http://localhost:3000"

# Stripe Checkout (Phase 3, packages/payments). Without both of these, checkout
# falls back to a dev-only mock payment page at /checkout/mock/[orderId] —
# refuses to do that in NODE_ENV=production.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Report delivery email (Phase 3, packages/email). Without these, sent email
# is written to apps/web/.local-emails/ instead of actually sending.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS="INNER <reports@example.com>"

# Admin login (Phase 5). Used only when seeding — sets the seeded admin
# user's credentials. Change ADMIN_PASSWORD before seeding any real
# environment; the fallback is a dev-only default.
# ADMIN_EMAIL="admin@inner.dev"
# ADMIN_PASSWORD=

# Re-engagement batch job (Phase 6, checkout reminders + recommendation
# nudges). Without this, /api/admin/jobs/reengagement only accepts an admin
# session (the "Run now" button in /admin/analytics) — set it to also allow
# an external scheduler (Vercel Cron, a systemd timer, etc.) to call it via
# `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=

# --- Wired in later phases, listed here so the shape is known up front ---
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
