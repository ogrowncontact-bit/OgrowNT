# Banco de dados
DATABASE_URL="postgresql://ogrownt:ogrownt@localhost:5432/ogrownt?schema=public"

# Servidor
PORT=3000

# Chave usada para criptografar (AES-256-GCM) os tokens de acesso do WhatsApp
# salvos no banco de cada empresa. Gere com: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# App do WhatsApp Business Platform (criado em https://developers.facebook.com)
# Um unico Meta App serve todas as empresas (multi-tenant); cada empresa conecta
# seu proprio numero/token (ver WhatsAppAccount no banco).
WHATSAPP_APP_SECRET=
# Token arbitrario que voce escolhe e cola no dashboard da Meta ao configurar o webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Nome e idioma do template aprovado usado para lembretes proativos
WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
WHATSAPP_REMINDER_TEMPLATE_LANG=pt_BR

# IA (Claude) para respostas livres / fora do fluxo guiado
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Intervalo (ms) em que o worker de lembretes verifica agendamentos proximos
REMINDER_CHECK_INTERVAL_MS=300000

# Autenticacao (login do painel/API de administracao)
# Gere com: openssl rand -hex 32
JWT_SECRET=
