# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg://ogrownt:ogrownt@localhost:5432/ogrownt

# --- Auth (single admin user) ---
# ADMIN_PASSWORD and JWT_SECRET below are refused at startup if left at
# these exact placeholder values (packages/shared/settings.py) — the app
# will not boot insecurely by accident. Generate a real JWT_SECRET with
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Browser origins allowed to call this API (CORS), comma-separated. Only the
# dashboard's own origin(s) belong here — never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paper trading ---
INITIAL_PAPER_CAPITAL=10000

# --- Market data provider ---
# "mock" is the only provider implemented so far.
# Real providers (binance, alpaca, ...) are adapters to be added later behind the
# same MarketDataProvider interface — see packages/data/connectors/market/base.py
MARKET_DATA_PROVIDER=mock
SCAN_INTERVAL_SECONDS=60
STRATEGY_INTERVAL_SECONDS=900

# --- News provider ---
# "mock" generates clearly-fake headlines — see packages/data/connectors/news/mock.py
NEWS_PROVIDER=mock
NEWS_INTERVAL_SECONDS=900

# --- Research Agent (Phase 5) ---
# How often packages/quant/learning/research.py scans pattern_performance/
# strategy_performance for underperformers and proposes+validates
# learned_rules. Much longer than the other cadences on purpose — this data
# only changes as fast as trades close.
RESEARCH_INTERVAL_SECONDS=3600

# --- LLM (News Intelligence Agent interpretation) ---
# Leave empty to run with news ingestion but no interpretation (news_impact
# stays empty, the scoring engine's "news" input stays neutral) — this is a
# fully valid, honest state, not an error. Set a real key to enable it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Alert delivery channels (Phase 7) ---
# Every field below is independently optional. Leaving a channel's fields
# empty means that channel is skipped — alerts still land in the `alerts`
# table and dashboard either way, this only controls whether they're also
# pushed out. See packages/notifications/.
ALERT_DELIVERY_INTERVAL_SECONDS=60

# Email (stdlib smtplib, STARTTLS) — all four required to enable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Telegram (Bot API) — create a bot via @BotFather for the token, and
# message the bot once to find your chat_id (e.g. via the /getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp is not implemented — see packages/notifications/channels/whatsapp.py
# for why (needs a real Business API account this project doesn't have).

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
