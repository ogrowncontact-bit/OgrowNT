# Postgres connection used by packages/db (Prisma).
# Local dev default matches the dev role/database created for this repo.
DATABASE_URL="postgresql://inner_dev:inner_dev@localhost:5432/inner_dev?schema=public"

# Anonymous session cookie signing secret (Phase 1). Generate a long random value per environment.
SESSION_SECRET="dev-only-change-me"

# AES-256 key for encrypting open-text assessment answers at rest (Phase 1, §12).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="dev-only-change-me"

# Question AI, Response AI, Profile AI (Phase 2, packages/ai). Every AI call
# degrades gracefully without this — set it to see live model output instead
# of the deterministic fallback heuristics.
# ANTHROPIC_API_KEY=

# --- Wired in later phases, listed here so the shape is known up front ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
