// Schema do OgrowNT - assistente de WhatsApp para agendamentos (multi-empresa)
// Toda tabela de negocio carrega businessId para isolar dados por tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MessageDirection {
  IN
  OUT
}

// Quem efetivamente escreveu a mensagem OUT (o cliente so gera CUSTOMER).
// Separado de MessageDirection porque uma mensagem OUT tanto pode vir do
// agente de IA quanto de um humano que assumiu a conversa no Inbox (Fase 7).
enum MessageSender {
  CUSTOMER
  AGENT
  HUMAN
  SYSTEM
}

// Nicho do negocio - determina qual template de configuracao/onboarding e
// exibido, mas o core (booking, conversas, etc) e o mesmo para todos.
enum BusinessIndustry {
  EQUESTRIAN
  KITE_SCHOOL
  RESTAURANT
  COFFEE_SHOP
  HOSTEL
  OTHER
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

// Canal de mensageria da conversa. So WHATSAPP esta implementado nesta fase -
// ver src/channels/ (ChannelAdapter). INSTAGRAM existe no schema para o dado
// ja nascer pronto para reportar/filtrar por canal quando essa integracao
// for construida (recurso premium futuro).
enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

enum AgentTone {
  FRIENDLY
  PROFESSIONAL
  CASUAL
  PREMIUM
}

enum Formality {
  FORMAL
  NEUTRAL
  CASUAL
}

enum EmojiUsage {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum KnowledgeCategory {
  COMPANY
  SERVICES
  PRICING
  FAQ
  POLICIES
  LOCATION
  RULES
  DOCUMENTS
}

model Business {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  industry    BusinessIndustry
  timezone    String           @default("America/Sao_Paulo")
  description String?
  address     String?
  phone       String?
  // Campos especificos do nicho que nao justificam uma coluna propria (ver
  // src/templates/registry.ts para o que cada industry costuma usar aqui).
  metadata    Json             @default("{}")
  // Motor multilingue (ver src/language/) - codigos ISO 639-1 (pt, en, es...).
  defaultLanguage    String   @default("pt")
  supportedLanguages String[] @default(["pt"])
  currency           String   @default("BRL")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships      Membership[]
  whatsAppAccount  WhatsAppAccount?
  services         Service[]
  businessHours    BusinessHours[]
  customers        Customer[]
  bookings         Booking[]
  conversations    Conversation[]
  agent            Agent?
  knowledgeEntries KnowledgeEntry[]
  businessRules    BusinessRule[]
  resources        Resource[]
  customFields     CustomBookingField[]
  toolCallLogs     ToolCallLog[]
  automations      Automation[]
}

// Identidade/voz do "funcionario digital" da empresa - como ele fala, nao o
// que ele sabe (isso e KnowledgeEntry) nem o que pode fazer (isso sao as
// tools em src/ai/tools.ts). Um agente por empresa no MVP.
model Agent {
  id              String     @id @default(cuid())
  businessId      String     @unique
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String     @default("Assistente")
  tone            AgentTone  @default(FRIENDLY)
  formality       Formality  @default(NEUTRAL)
  emojiUsage      EmojiUsage @default(LOW)
  greetingMessage String?
  // Instrucoes extras em linguagem natural definidas pela empresa (exibido
  // no futuro dashboard como "Comportamento do agente", nao "system prompt").
  instructions    String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Base de conhecimento consultada pelo agente via tool (search_knowledge) -
// nunca injetada por inteiro no prompt. Regra de ouro: o agente NAO inventa
// informacao que nao esta aqui.
model KnowledgeEntry {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   KnowledgeCategory
  title      String
  content    String
  language   String            @default("pt")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId, category])
}

// Regras de negocio em linguagem natural (ex: "nao aceitamos grupos maiores
// que 10 pessoas") - injetadas no system prompt do agente, acima da
// identidade, para que tenham prioridade sobre o "tom" da conversa.
model BusinessRule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([businessId])
}

// Usuario humano que faz login no painel/API de administracao (dono/equipe da
// empresa) - diferente de Customer, que e quem conversa pelo WhatsApp.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships           Membership[]
  assignedConversations Conversation[]
  conversationNotes     ConversationNote[]
}

// Vinculo de um User a um Business com um papel - garante isolamento
// multi-tenant (nenhuma rota de negocio roda sem checar isso) e controla
// permissoes (Role).
model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model WhatsAppAccount {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumberId       String   @unique
  wabaId              String
  verifiedName        String?
  // Token de acesso da Graph API, criptografado em repouso (ver src/crypto.ts)
  encryptedAccessToken String
  connectedAt         DateTime @default(now())
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)
  // Campos especificos do nicho (ex: experienceLevel, minAge, skillLevel) -
  // ver src/templates/registry.ts.
  metadata        Json     @default("{}")
  // Tipo de Resource necessario para este servico (ex: "horse", "table",
  // "room") - null (padrao) = agenda compartilhada da empresa, sem recurso
  // dedicado, comportamento identico as fases anteriores. Quando definido, o
  // motor de reservas (src/booking/engine.ts) so oferece um horario se
  // houver pelo menos um Resource desse tipo livre e com capacidade
  // suficiente.
  requiresResourceType String?
  createdAt       DateTime @default(now())

  bookings     Booking[]
  customFields CustomBookingField[]

  @@index([businessId])
}

// Recurso escasso necessario para realizar um servico - universal entre
// nichos (cavalo/instrutor/arena na hipica, mesa/sala no restaurante,
// quarto/cama no hostel, etc). "type" e texto livre (nao enum) porque varia
// demais entre nichos; Service.requiresResourceType e o que os conecta.
model Resource {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  name       String
  // Quantas reservas/pessoas este recurso comporta ao mesmo tempo (ex: mesa
  // capacidade 4, cavalo capacidade 1).
  capacity   Int      @default(1)
  active     Boolean  @default(true)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  bookings Booking[]

  @@index([businessId, type])
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

// Pergunta especifica que a empresa quer que o agente faca ao reservar um
// servico (ex: "Qual seu nivel de experiencia?"). serviceId nulo = pergunta
// vale para qualquer servico da empresa. Consultado pela IA (tool
// list_services) para saber o que perguntar antes de criar a reserva; as
// respostas vao em Booking.metadata. O fluxo guiado (botoes) nao coleta
// campos customizados - fica a cargo da IA, que lida melhor com perguntas
// abertas.
model CustomBookingField {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label      String
  fieldType  FieldType
  options    String[]  @default([]) // usado quando fieldType = SELECT
  required   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// Horario de funcionamento por dia da semana (0 = domingo .. 6 = sabado).
// Pode haver mais de um intervalo por dia (ex: manha e tarde).
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int // 0-6
  openTime   String // "HH:mm"
  closeTime  String // "HH:mm"

  @@index([businessId, weekday])
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber String // formato E.164, ex: 5511999999999
  name        String?
  // "auto" = segue a deteccao automatica a cada mensagem; um codigo ISO 639-1
  // (pt/en/es...) = cliente ja trocou de idioma ou definiu preferencia.
  preferredLanguage String @default("auto")
  createdAt   DateTime @default(now())

  bookings      Booking[]
  conversations Conversation[]

  @@unique([businessId, phoneNumber])
}

model Booking {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service       @relation(fields: [serviceId], references: [id])
  resourceId String?
  resource   Resource?     @relation(fields: [resourceId], references: [id])
  quantity   Int           @default(1)
  notes      String?
  // Respostas dos CustomBookingField desse servico (ex: {"experienceLevel":"iniciante"}).
  metadata   Json          @default("{}")
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  automationLogs AutomationLog[]

  @@index([businessId, startsAt])
  @@index([serviceId, startsAt])
  @@index([resourceId, startsAt])
}

// Log de observabilidade das chamadas de ferramentas da IA (secao "Tool
// Execution" / observabilidade). Sem FK para Conversation de proposito (log
// operacional, nao precisa de integridade referencial forte); guarda so o
// necessario para depurar - nunca o conteudo completo de mensagens.
model ToolCallLog {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  toolName       String
  input          Json
  success        Boolean
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
}

// Automacao proativa configuravel por empresa (Fase 9) - lembrete antes do
// horario ou follow-up depois. O TEXTO da mensagem em si NAO e livre: fora
// da janela de 24h de uma conversa iniciada pelo cliente, o WhatsApp exige
// um template pre-aprovado no Meta Business Manager (mesma regra ja usada
// pelos lembretes desde a Fase 1) - por isso so o gatilho e o offset sao
// configuraveis aqui; o nome/idioma do template de cada trigger continua
// global (ver config.whatsapp.reminderTemplate*/followupTemplate*). Prometer
// "personalize sua mensagem" quando isso na pratica nao chegaria ao cliente
// seria simular uma integracao que nao existe de verdade.
enum AutomationTrigger {
  BOOKING_REMINDER
  BOOKING_FOLLOWUP
}

model Automation {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trigger       AutomationTrigger
  active        Boolean           @default(true)
  // REMINDER: minutos ANTES de Booking.startsAt. FOLLOWUP: minutos DEPOIS de Booking.endsAt.
  offsetMinutes Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  logs AutomationLog[]

  @@unique([businessId, trigger, offsetMinutes])
  @@index([businessId])
}

// Evita reenvio duplicado da mesma automacao para o mesmo agendamento -
// substitui o antigo ReminderLog (que so cobria lembretes hardcoded).
model AutomationLog {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sentAt       DateTime   @default(now())

  @@unique([automationId, bookingId])
}

// Estado da conversa guiada (menu -> servico -> horario -> confirmacao) por cliente.
model Conversation {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  step         String   @default("idle")
  data         Json     @default("{}")
  needsHuman   Boolean  @default(false)
  channel      ChannelType @default(WHATSAPP)
  // Funcionario que "assumiu" a conversa no Inbox (ver Fase 7) - null =
  // ninguem assumiu ainda, qualquer membro da equipe pode responder.
  assignedToUserId String?
  assignedTo       User?   @relation(fields: [assignedToUserId], references: [id])
  // Idioma (ISO 639-1) detectado na ultima mensagem de texto do cliente.
  detectedLanguage String?
  lastMessageAt DateTime @default(now())

  messages Message[]
  notes    ConversationNote[]

  @@unique([businessId, customerId])
}

model Message {
  id                String            @id @default(cuid())
  conversationId    String
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  sender            MessageSender     @default(CUSTOMER)
  content           String
  whatsAppMessageId String?
  createdAt         DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// Nota interna da equipe numa conversa (visivel so no Inbox, nunca enviada
// ao cliente) - para contexto entre atendentes (ex: "cliente e alergico a
// amendoim", "ja ligamos, aguardando retorno").
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
