{
  "name": "inner",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "sharp"]
  },
  "scripts": {
    "dev": "pnpm --filter @inner/web dev",
    "build": "pnpm -r --filter=!@inner/web build && pnpm --filter @inner/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @inner/db generate",
    "db:migrate": "pnpm --filter @inner/db migrate",
    "db:seed": "pnpm --filter @inner/db seed"
  }
}
