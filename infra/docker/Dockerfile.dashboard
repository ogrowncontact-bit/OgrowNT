FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# node:20-alpine ships a built-in non-root `node` user (uid/gid 1000) for
# exactly this purpose — chown after build (which needs root to write
# node_modules/.next), then drop privileges for the actual server process.
RUN chown -R node:node /app
USER node

EXPOSE 3000
CMD ["npm", "start"]
